# Legacy inline-four layout: version source/docs only, including subdirectories.
# Generated reports, images, video, render frames, CAD and archives stay local.
/examples/inline_four_cad/**
!/examples/inline_four_cad/**/
!/examples/inline_four_cad/**/*.py
!/examples/inline_four_cad/**/*.FCMacro
!/examples/inline_four_cad/**/*.md
/examples/inline_four_cad/**/__pycache__/
/examples/inline_four_cad/archive/
/examples/inline_four_cad/session_close_*/
